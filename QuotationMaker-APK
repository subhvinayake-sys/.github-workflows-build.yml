          <script src="lib/html2canvas.min.js"></script>
          <script src="lib/jspdf.umd.min.js"></script>
          <script>
          const $=s=>document.querySelector(s),sh=$('#sheet'),st=$('#stage'),K='qt_maker_v1';
          const N=v=>parseFloat(String(v).replace(/[^0-9.\-]/g,''));
          const F=n=>'₹ '+n.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
          const row=()=>'<tr class="it"><td></td><td class="e"></td><td class="e c"></td><td class="e c"></td><td class="e r"></td><td class="e r"></td></tr>';
          const store=(f)=>{try{return f()}catch(e){return null}};
          function edit(){sh.querySelectorAll('.e').forEach(x=>x.contentEditable='true')}
          function calc(){let t=0;const ae=document.activeElement;
           $('#items').querySelectorAll('tr').forEach((r,i)=>{const c=r.cells;c[0].textContent=c[1].innerText.trim()?i+1:'';
            const q=N(c[3].innerText),p=N(c[4].innerText);
            if(!isNaN(q)&&!isNaN(p)&&ae!==c[5])c[5].textContent=F(q*p);
            const a=N(c[5].innerText);if(!isNaN(a))t+=a});
           $('#tot').textContent=F(t);
           const ad=N($('#adv').innerText)||0,rn=N($('#rnd').innerText)||0;
           $('#bal').textContent=F(t-ad+rn)}
          let tm;function save(){clearTimeout(tm);tm=setTimeout(()=>store(()=>localStorage.setItem(K,sh.innerHTML)),400)}
          function fit(){const s=Math.min(1,(innerWidth-12)/794);sh.style.transform='scale('+s+')';st.style.width=794*s+'px';st.style.height=sh.offsetHeight*s+'px'}
          // initial template
          $('#items').innerHTML=Array(17).fill(row()).join('');
          const r0=$('#items').rows[0].cells;r0[1].textContent="CONCREATE CUTTER 14'' XTRA POWER";r0[2].textContent='NOS';r0[3].textContent='1';r0[4].textContent='₹ 25,000.00';
          $('#dt').textContent=new Date().toLocaleDateString('en-GB').replace(/\//g,'-');
          const ORIG=sh.innerHTML;
          const sv=store(()=>localStorage.getItem(K));if(sv)sh.innerHTML=sv;
          edit();calc();fit();new ResizeObserver(fit).observe(sh);addEventListener('resize',fit);
          sh.addEventListener('input',()=>{calc();save()});
          sh.addEventListener('focusout',e=>{const t=e.target;
           if(t.matches('#items td:nth-child(5),#adv,#rnd')){const n=N(t.innerText);if(!isNaN(n))t.textContent=F(n)}calc();save()});
          sh.addEventListener('paste',e=>{e.preventDefault();document.execCommand('insertText',false,(e.clipboardData||window.clipboardData).getData('text'))});
          sh.addEventListener('change',e=>{if(e.target.type!=='file'||!e.target.files[0])return;
           const fr=new FileReader();fr.onload=()=>{sh.querySelectorAll('.logo').forEach(l=>{l.style.backgroundImage='url('+fr.result+')';l.firstChild.textContent=''});save()};fr.readAsDataURL(e.target.files[0])});
          $('#add').onclick=()=>{$('#items').insertAdjacentHTML('beforeend',row());edit();calc();save()};
          $('#del').onclick=()=>{const t=$('#items');if(t.rows.length>1){t.deleteRow(-1);calc();save()}};
          $('#rst').onclick=()=>{if(confirm('Naya quotation? Purana sab saaf ho jayega.')){store(()=>localStorage.removeItem(K));sh.innerHTML=ORIG;edit();calc()}};
          $('#pdf').onclick=async()=>{const b=$('#pdf');b.disabled=true;b.textContent='Ban raha hai…';
           if(document.activeElement)document.activeElement.blur();calc();
           sh.style.transform='none';st.style.height='auto';
           try{const cv=await html2canvas(sh,{scale:2,backgroundColor:'#fff',scrollX:0,scrollY:-scrollY,useCORS:true});
            const d=new window.jspdf.jsPDF('p','mm','a4');let w=210,h=w*cv.height/cv.width;if(h>297){h=297;w=h*cv.width/cv.height}
            d.addImage(cv.toDataURL('image/jpeg',.95),'JPEG',(210-w)/2,0,w,h);
            const nm='Quotation_'+($('#qn').innerText.trim()||'x')+'_'+($('#to').innerText.trim().replace(/[^\w]+/g,'_')||'')+'.pdf';
            if(window.Android)Android.savePdf(d.output('datauristring').split(',')[1],nm);else d.save(nm);
           }catch(e){if(!e||e.code!=='declined')alert('PDF nahi bani, dobara try karein.')}
           b.disabled=false;b.textContent='PDF Download';fit()};
          </script></body></html>
          EOF
          cd /tmp && npm pack html2canvas@1.4.1 jspdf@2.5.1 >/dev/null 2>&1
          mkdir h j && tar xzf html2canvas-1.4.1.tgz -C h && tar xzf jspdf-2.5.1.tgz -C j
          cd $GITHUB_WORKSPACE
          cp /tmp/h/package/dist/html2canvas.min.js app/src/main/assets/lib/
          cp /tmp/j/package/dist/jspdf.umd.min.js app/src/main/assets/lib/
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: QuotationMaker-APK
          path: app/build/outputs/apk/debug/app-debug.apk
