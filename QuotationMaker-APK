          .tt{flex:1;border:0}.tt td{height:25px;font-weight:700;font-size:15px}.tt td:nth-child(2){text-align:right;width:130px}
          #bal{background:#00b0f0;color:#c00}
          #bar{position:fixed;left:0;right:0;bottom:0;background:var(--bar);border-top:1px solid var(--bd);display:flex;gap:8px;padding:10px 10px calc(10px + env(safe-area-inset-bottom,0px))}
